# ════════════════════════════════════════════════════════════════════
# NetraX 3.0 — Real-Time Notification & Environment Configuration
# ════════════════════════════════════════════════════════════════════
# Copy this file to '.env' in the root directory and add your credentials:
#   cp .env.example .env

# ── 1. Telegram Bot Notification (RECOMMENDED) ──────────────────────
# Step 1: Open Telegram and search for @BotFather -> send /newbot
# Step 2: Paste your Bot Token below (e.g. 7123456789:AAHk...)
TELEGRAM_BOT_TOKEN=""

# Step 3: Open Telegram and search for @userinfobot -> click Start
# Step 4: Paste your Chat ID below (e.g. 123456789)
TELEGRAM_CHAT_ID=""


# ── 2. Discord Webhook Notification (OPTIONAL) ──────────────────────
# Paste your Discord webhook URL below if you wish to receive Discord alerts:
DISCORD_WEBHOOK_URL=""
